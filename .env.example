# ============================================================
#  로컬 실행용 환경변수 예시
#  이 파일을 복사해 .env 로 만든 뒤 값을 채우고,
#  실행 전 셸에 export 하거나 GitHub Secrets 에 동일한 키로 등록한다.
#  ※ .env 는 절대 커밋하지 말 것 (.gitignore 에 등록됨)
# ============================================================

# --- SMTP (메일 발송) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx        # Gmail 앱 비밀번호 16자리 (계정 비밀번호 아님)
MAIL_FROM=AI CVE Watch <your-account@gmail.com>

# --- NVD API 키 (선택) ---
# 없어도 동작하지만 요청 간 6.5초 대기가 걸린다.
# https://nvd.nist.gov/developers/request-an-api-key 에서 무료 발급
NVD_API_KEY=

# --- GitHub 토큰 (GHSA GraphQL 조회용) ---
# GitHub Actions 에서는 자동 주입되므로 로컬 테스트에서만 필요.
# public_repo 권한만 있으면 충분하다.
GITHUB_TOKEN=

# --- GitHub Pages 기본 URL (메일 본문 링크용, 선택) ---
SITE_BASE_URL=
